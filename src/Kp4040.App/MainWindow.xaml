<Window x:Class="Kp4040.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KP-4040 AI Controller" Width="1040" Height="790"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#F6F7F9" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172033" />
        <SolidColorBrush x:Key="Muted" Color="#626B78" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="KP-4040 AI Controller" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="Monitor XInput, atalhos e mouse analógico · Alpha 0.5.1" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <CheckBox x:Name="ActionsEnabledCheck" Content="Habilitar execução de ações"
                          FontWeight="SemiBold" HorizontalAlignment="Right" />
                <CheckBox x:Name="AnalogMouseEnabledCheck" Content="Analógicos: mouse e scroll"
                          FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0" />
                <TextBlock Text="Desligada a cada inicialização" FontSize="11"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="13" Padding="20"
                    BorderBrush="#E5E8ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Dispositivo" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock x:Name="ConnectionText" Text="Procurando controle..."
                               Margin="0,14,0,5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConnectionDetailText" Text="XInput 1.4 · Windows 11"
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                    <Separator Margin="0,18,0,17" Background="#E5E8ED" />
                    <TextBlock Text="Último evento" FontWeight="SemiBold" />
                    <TextBlock x:Name="LastEventText" Text="Aguardando entradas..."
                               TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,9,0,0" />
                    <TextBlock Text="Última ação" FontWeight="SemiBold" Margin="0,22,0,0" />
                    <TextBlock x:Name="LastActionText" Text="Ações desativadas"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0" />
                    <Separator Margin="0,18,0,17" Background="#E5E8ED" />
                    <TextBlock Text="Entradas analógicas" FontWeight="SemiBold" />
                    <TextBlock Text="Gatilhos (0–255)" Foreground="{StaticResource Muted}" Margin="0,14,0,4" FontSize="12" />
                    <TextBlock x:Name="TriggersText" Text="LT: 0 | RT: 0" FontFamily="Consolas" />
                    <TextBlock Text="Stick esquerdo (LX / LY)" Foreground="{StaticResource Muted}" Margin="0,16,0,4" FontSize="12" />
                    <TextBlock x:Name="LeftStickText" Text="0 / 0" FontFamily="Consolas" />
                    <TextBlock Text="Stick direito (RX / RY)" Foreground="{StaticResource Muted}" Margin="0,16,0,4" FontSize="12" />
                    <TextBlock x:Name="RightStickText" Text="0 / 0" FontFamily="Consolas" />
                    <TextBlock Text="Stick esquerdo: cursor. Stick direito: scroll vertical e horizontal. Ative no topo."
                               Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,20,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="13" Padding="20"
                    BorderBrush="#E5E8ED" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mapeamento de botões" FontWeight="SemiBold" FontSize="17" />
                            <TextBlock Text="Defina uma ação para cada entrada do XInput."
                                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="IdentifyButton" Content="Identificar botão"
                                    Click="IdentifyButton_Click" Margin="0,0,8,0" />
                            <Button x:Name="SaveProfileButton" Content="Salvar perfil"
                                    Click="SaveProfileButton_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="IdentifyStatusText"
                               Text="Clique em Identificar botão e pressione um botão do controle."
                               Foreground="#26598E" FontSize="12" Margin="0,0,0,8"
                               TextWrapping="Wrap" />
                    <Grid Grid.Row="2" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="205" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BOTÃO / STATUS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" />
                        <TextBlock Grid.Column="1" Text="AÇÃO" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" />
                    </Grid>
                    <ListBox Grid.Row="3" x:Name="MappingList" ItemsSource="{Binding Bindings}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#ECEEF2" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                    <Setter Property="Background" Value="#E5F6EC" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsIdentified}" Value="True">
                                                    <Setter Property="Background" Value="#DCEBFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="205" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,9,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#C8CFD9" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                <Setter Property="Fill" Value="#1D9E5A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,3,0">
                                            <ComboBox ItemsSource="{Binding Choices}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Kind"
                                                      SelectedValue="{Binding SelectedAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="{Binding ShortcutLabel}" Click="CaptureShortcut_Click"
                                                    Margin="0,4,0,0" Padding="8,4" HorizontalAlignment="Stretch">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsShortcut}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="4" x:Name="ProfileStatusText" FontSize="11" Margin="0,12,0,0"
                               Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                               Text="Perfil local · JSON" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="2,15,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                   Text="Para testar Ctrl+C / Ctrl+V / Enter, habilite as ações e coloque o foco em outro aplicativo (ex.: Bloco de Notas). Nenhuma chave de API é necessária." />
    </Grid>
</Window>
